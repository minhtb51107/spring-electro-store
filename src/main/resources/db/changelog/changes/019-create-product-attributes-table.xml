<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="019-create-product-attributes-table" author="minh">
        <createTable tableName="product_attributes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_product_attributes_product_id" references="products(id)"/>
            </column>
            <column name="attribute_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="attribute_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <createIndex tableName="product_attributes" indexName="idx_product_attributes_product_id">
            <column name="product_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>